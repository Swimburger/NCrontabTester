@using System.Globalization
@using NCrontab
@inject ILogger<App> Logger
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<section class="expression-panel" aria-labelledby="expression-heading">
    <h2 id="expression-heading" class="visually-hidden">Test an expression</h2>
    <label class="section-label" for="crontab-expression">NCrontab expression</label>
    <p id="cron-hint" class="field-hint">
        Field order: <code>second minute hour day month weekday</code> (six fields), or
        <code>minute hour day month weekday</code> (five fields).
    </p>
    <div class="expression-row">
        <input @oninput="HandleCronInput"
               @onblur="HandleCronBlur"
               value="@cronExpression"
               placeholder="e.g. 0 0 12 * */2 Mon"
               class="form-control font-monospace"
               id="crontab-expression"
               name="expression"
               type="text"
               autocapitalize="none"
               autocorrect="off"
               autocomplete="off"
               spellcheck="false"
               aria-invalid="@((!isExpressionValid).ToString().ToLowerInvariant())"
               aria-describedby="@CronDescribedBy" />
        <button @onclick="CopyLink"
                type="button"
                class="btn btn-outline-brand"
                disabled="@(!isExpressionValid || validationPending || !isStartValid)">
            Copy link
        </button>
    </div>
    <p id="cron-error"
       class="validation-message"
       aria-live="polite"
       hidden="@string.IsNullOrEmpty(errorMessage)">@errorMessage</p>
    <p class="copy-status" role="status" aria-live="polite">@copyStatus</p>

    @if (!isExpression6PartFormat && isExpressionValid && !validationPending)
    {
        <div class="notice notice-warning" role="status">
            This is the classic five-field CRON format. Azure Functions and Azure WebJobs use the six-field
            NCrontab format, including seconds.
        </div>
    }
</section>

<details class="schedule-options">
    <summary>
        <span>Schedule options</span>
        <span class="summary-meta">Presets, timezone, and start time</span>
    </summary>
    <div class="options-grid">
        <section aria-labelledby="presets-label">
            <h2 id="presets-label" class="option-heading">Presets and interpretation</h2>
            <div class="button-row">
                <button type="button" class="btn btn-secondary" @onclick="ApplyFiveFieldEveryMinutePreset">
                    Five-field: every minute
                </button>
                <button type="button" class="btn btn-secondary" @onclick="ApplySixFieldEveryMinutePreset">
                    Six-field: every minute
                </button>
                <button type="button" class="btn btn-secondary" @onclick="ApplyDailyNoonPreset">
                    Six-field: daily at noon
                </button>
            </div>
            @if (!string.IsNullOrEmpty(scheduleSummary))
            {
                <p id="schedule-summary" class="schedule-summary"><strong>Summary:</strong> @scheduleSummary</p>
            }
        </section>

        <section aria-labelledby="time-heading">
            <h2 id="time-heading" class="option-heading">Time settings</h2>
            <fieldset class="timezone-options">
                <legend class="section-label">Interpret the schedule in</legend>
                <label>
                    <input type="radio"
                           name="timezone"
                           value="local"
                           checked="@(timeZoneMode == ScheduleTimeZone.BrowserLocal)"
                           @onchange="UseBrowserLocalTime" />
                    Browser local time
                </label>
                <label>
                    <input type="radio"
                           name="timezone"
                           value="utc"
                           checked="@(timeZoneMode == ScheduleTimeZone.Utc)"
                           @onchange="UseUtc" />
                    UTC
                </label>
            </fieldset>

            <label class="section-label" for="start-date-time">Start date and time (optional)</label>
            <p id="start-hint" class="field-hint">
                Leave blank to start from now. A supplied value uses the active time zone.
            </p>
            <input id="start-date-time"
                   name="start"
                   type="datetime-local"
                   step="60"
                   class="form-control start-date-time"
                   value="@startDateTimeText"
                   @onchange="HandleStartChanged"
                   aria-invalid="@((!isStartValid).ToString().ToLowerInvariant())"
                   aria-describedby="@(isStartValid ? "start-hint" : "start-hint start-error")" />
            <p id="start-error"
               class="validation-message"
               aria-live="polite"
               hidden="@isStartValid">Enter a complete date and time.</p>
        </section>
    </div>
    <p class="timezone-note">
        Azure schedules commonly run in UTC unless the host time zone is configured. Browser-local mode skips
        nonexistent spring-forward times and shows both offsets for repeated fall-back times.
    </p>
</details>

<section class="results-panel" aria-labelledby="occurrences-heading">
    <div class="results-heading-row">
        <div>
            <div class="occurrences-heading-row">
                <h2 id="occurrences-heading" class="section-heading">Next occurrences</h2>
                @if (occurrences.Count > 0)
                {
                    <span class="badge" aria-label="@($"{occurrences.Count} occurrences")">@occurrences.Count</span>
                }
            </div>
            <p id="active-timezone" class="active-timezone"><strong>Active time zone:</strong> @ActiveTimeZoneLabel</p>
        </div>
    </div>
    <p class="visually-hidden" role="status" aria-live="polite">@occurrenceStatus</p>
    <ol class="occurrences-list">
        @foreach (var occurrence in occurrences)
        {
            var (relativeClass, relativeText) = GetRelativeTime(occurrence);
            <li>
                <div class="occurrence-primary">
                    <time class="occurrence-time">@occurrence.ToString("yyyy-MM-dd HH:mm:ss")</time>
                    <span class="occurrence-zone">@GetOccurrenceZoneLabel(occurrence)</span>
                </div>
                <span class="occurrence-relative @relativeClass">@relativeText</span>
            </li>
        }
    </ol>
    <div class="results-actions">
        <button @onclick="ShowMoreOccurrences"
                type="button"
                class="btn btn-primary"
                disabled="@(!isExpressionValid || validationPending || !isStartValid)">
            Show 10 more
        </button>
    </div>
</section>

@code {
    private const string DefaultCronExpression = "0 0 12 * */2 Mon";
    private static readonly string[] FiveFieldNames = ["minute", "hour", "day", "month", "weekday"];
    private static readonly string[] SixFieldNames = ["second", "minute", "hour", "day", "month", "weekday"];
    private readonly List<DateTime> occurrences = [];
    private CancellationTokenSource? validationCancellation;
    private CrontabSchedule cronSchedule = CrontabSchedule.Parse(
        DefaultCronExpression,
        new CrontabSchedule.ParseOptions { IncludingSeconds = true });
    private string cronExpression = DefaultCronExpression;
    private string errorMessage = string.Empty;
    private string scheduleSummary = string.Empty;
    private string startDateTimeText = string.Empty;
    private bool isExpression6PartFormat = true;
    private bool isExpressionValid = true;
    private bool isStartValid = true;
    private bool validationPending;
    private int? pendingScrollToIndex;
    private string copyStatus = string.Empty;
    private string lastCopyStatus = string.Empty;
    private string occurrenceStatus = string.Empty;
    private int copyFeedbackVersion;
    private ScheduleTimeZone timeZoneMode = ScheduleTimeZone.BrowserLocal;

    private string CronDescribedBy => !isExpressionValid ? "cron-hint cron-error" : "cron-hint";

    private TimeZoneInfo SelectedTimeZone => timeZoneMode == ScheduleTimeZone.Utc
        ? TimeZoneInfo.Utc
        : TimeZoneInfo.Local;

    private string ActiveTimeZoneLabel
    {
        get
        {
            if (timeZoneMode == ScheduleTimeZone.Utc)
            {
                return "UTC";
            }

            var offset = SelectedTimeZone.GetUtcOffset(DateTime.Now);
            return $"Browser local — {SelectedTimeZone.Id} ({FormatUtcOffset(offset)})";
        }
    }

    protected override void OnInitialized()
    {
        var query = ParseQuery(new Uri(NavigationManager.Uri).Query);
        if (query.TryGetValue("expression", out var sharedExpression) && !string.IsNullOrWhiteSpace(sharedExpression))
        {
            cronExpression = sharedExpression;
        }

        if (query.TryGetValue("timezone", out var sharedTimeZone) &&
            string.Equals(sharedTimeZone, "utc", StringComparison.OrdinalIgnoreCase))
        {
            timeZoneMode = ScheduleTimeZone.Utc;
        }

        if (query.TryGetValue("start", out var sharedStart))
        {
            startDateTimeText = sharedStart;
            isStartValid = TryParseStartDateTime(out _);
        }

        SetExpression();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingScrollToIndex.HasValue)
        {
            var index = pendingScrollToIndex.Value;
            pendingScrollToIndex = null;
            try
            {
                ((IJSInProcessRuntime)JSRuntime).InvokeVoid("scrollToOccurrence", index);
            }
            catch (JSException exception)
            {
                Logger.LogWarning(exception, "Unable to scroll to occurrence {OccurrenceIndex}.", index);
            }
        }

        return Task.CompletedTask;
    }

    private async Task HandleCronInput(ChangeEventArgs eventArgs)
    {
        cronExpression = eventArgs.Value?.ToString() ?? string.Empty;
        validationCancellation?.Cancel();
        validationCancellation?.Dispose();
        validationCancellation = new CancellationTokenSource();
        var token = validationCancellation.Token;

        validationPending = true;
        errorMessage = string.Empty;
        isExpressionValid = true;
        scheduleSummary = string.Empty;
        occurrences.Clear();
        occurrenceStatus = string.Empty;

        try
        {
            await Task.Delay(350, token);
            if (!token.IsCancellationRequested)
            {
                SetExpression();
            }
        }
        catch (OperationCanceledException)
        {
            // A later input or blur owns validation now.
        }
    }

    private void HandleCronBlur(FocusEventArgs _)
    {
        validationCancellation?.Cancel();
        SetExpression();
    }

    private void HandleStartChanged(ChangeEventArgs eventArgs)
    {
        startDateTimeText = eventArgs.Value?.ToString() ?? string.Empty;
        isStartValid = TryParseStartDateTime(out _);
        if (isStartValid)
        {
            SetExpression();
        }
        else
        {
            occurrences.Clear();
        }
    }

    private void UseBrowserLocalTime(ChangeEventArgs _)
    {
        timeZoneMode = ScheduleTimeZone.BrowserLocal;
        SetExpression();
    }

    private void UseUtc(ChangeEventArgs _)
    {
        timeZoneMode = ScheduleTimeZone.Utc;
        SetExpression();
    }

    private void ApplyPreset(string preset)
    {
        cronExpression = preset;
        validationCancellation?.Cancel();
        SetExpression();
    }

    private void ApplyFiveFieldEveryMinutePreset() => ApplyPreset("* * * * *");

    private void ApplySixFieldEveryMinutePreset() => ApplyPreset("0 * * * * *");

    private void ApplyDailyNoonPreset() => ApplyPreset("0 0 12 * * *");

    private void ShowMoreOccurrences()
    {
        var firstNewIndex = occurrences.Count;
        AppendOccurrences();
        pendingScrollToIndex = firstNewIndex;
        occurrenceStatus = $"Showing {occurrences.Count} occurrences.";
    }

    private void AppendOccurrences()
    {
        if (!isExpressionValid || !isStartValid)
        {
            return;
        }

        var mostRecentDate = occurrences.Count == 0 ? GetScheduleStart() : occurrences[^1];
        var added = 0;
        var attempts = 0;
        while (added < 10 && attempts++ < 100_000)
        {
            mostRecentDate = cronSchedule.GetNextOccurrence(mostRecentDate);
            if (timeZoneMode == ScheduleTimeZone.BrowserLocal && SelectedTimeZone.IsInvalidTime(mostRecentDate))
            {
                continue;
            }

            occurrences.Add(mostRecentDate);
            added++;
        }

        if (added < 10)
        {
            errorMessage = "The next ten valid occurrences could not be calculated.";
            isExpressionValid = false;
        }
    }

    private void SetExpression()
    {
        validationPending = false;
        occurrences.Clear();
        occurrenceStatus = string.Empty;

        var fields = SplitFields(cronExpression);
        isExpression6PartFormat = fields.Length == 6;
        scheduleSummary = BuildScheduleSummary(fields);

        try
        {
            if (fields.Length is not (5 or 6))
            {
                throw new CrontabException("A CRON expression must contain five or six whitespace-separated fields.");
            }

            var normalizedExpression = string.Join(' ', fields);
            cronSchedule = CrontabSchedule.Parse(
                normalizedExpression,
                new CrontabSchedule.ParseOptions { IncludingSeconds = isExpression6PartFormat });
            errorMessage = string.Empty;
            isExpressionValid = true;

            if (isStartValid)
            {
                AppendOccurrences();
            }
        }
        catch (CrontabException exception)
        {
            errorMessage = $"Invalid expression: {exception.Message}";
            scheduleSummary = string.Empty;
            isExpression6PartFormat = true;
            isExpressionValid = false;
        }
    }

    private DateTime GetScheduleStart()
    {
        if (!string.IsNullOrWhiteSpace(startDateTimeText) && TryParseStartDateTime(out var suppliedStart))
        {
            return suppliedStart;
        }

        return timeZoneMode == ScheduleTimeZone.Utc ? DateTime.UtcNow : DateTime.Now;
    }

    private bool TryParseStartDateTime(out DateTime start)
    {
        if (string.IsNullOrWhiteSpace(startDateTimeText))
        {
            start = default;
            return true;
        }

        if (DateTime.TryParseExact(
                startDateTimeText,
                ["yyyy-MM-dd'T'HH:mm", "yyyy-MM-dd'T'HH:mm:ss"],
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var parsed))
        {
            start = DateTime.SpecifyKind(parsed, DateTimeKind.Unspecified);
            return true;
        }

        start = default;
        return false;
    }

    private async Task CopyLink()
    {
        var feedbackVersion = ++copyFeedbackVersion;
        var uri = new Uri(NavigationManager.Uri);
        var queryParts = new List<string>
        {
            $"expression={Uri.EscapeDataString(cronExpression.Trim())}",
            $"timezone={(timeZoneMode == ScheduleTimeZone.Utc ? "utc" : "local")}",
        };
        if (!string.IsNullOrWhiteSpace(startDateTimeText))
        {
            queryParts.Add($"start={Uri.EscapeDataString(startDateTimeText)}");
        }

        var uriToCopy = $"{uri.GetComponents(UriComponents.SchemeAndServer | UriComponents.Path, UriFormat.UriEscaped)}?{string.Join('&', queryParts)}";
        var copied = false;
        try
        {
            copied = await JSRuntime.InvokeAsync<bool>("copyText", uriToCopy);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Unable to copy the expression link.");
        }

        var nextCopyStatus = copied ? "Link copied" : "Copy failed";
        copyStatus = nextCopyStatus == lastCopyStatus ? $"{nextCopyStatus}\u00a0" : nextCopyStatus;
        lastCopyStatus = nextCopyStatus;

        await InvokeAsync(StateHasChanged);
        await Task.Delay(2000);
        if (feedbackVersion == copyFeedbackVersion)
        {
            copyStatus = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private (string cssClass, string text) GetRelativeTime(DateTime wallClockTime)
    {
        var occurrenceUtc = ToUtc(wallClockTime);
        var diff = occurrenceUtc - DateTime.UtcNow;
        var absolute = diff.Duration();
        var future = diff > TimeSpan.Zero;

        var cssClass = diff <= TimeSpan.Zero ? "occurrence-past"
            : diff.TotalDays <= 7 ? "occurrence-soon"
            : "occurrence-future";
        (int value, string unit) = absolute.TotalSeconds < 60 ? ((int)absolute.TotalSeconds, "second")
            : absolute.TotalMinutes < 60 ? ((int)absolute.TotalMinutes, "minute")
            : absolute.TotalHours < 24 ? ((int)absolute.TotalHours, "hour")
            : absolute.TotalDays < 30 ? ((int)absolute.TotalDays, "day")
            : absolute.TotalDays < 365 ? ((int)(absolute.TotalDays / 30), "month")
            : ((int)(absolute.TotalDays / 365), "year");
        var label = value == 1 ? unit : unit + "s";
        return (cssClass, future ? $"in {value} {label}" : $"{value} {label} ago");
    }

    private DateTime ToUtc(DateTime wallClockTime)
    {
        if (timeZoneMode == ScheduleTimeZone.Utc)
        {
            return DateTime.SpecifyKind(wallClockTime, DateTimeKind.Utc);
        }

        var unspecified = DateTime.SpecifyKind(wallClockTime, DateTimeKind.Unspecified);
        if (SelectedTimeZone.IsAmbiguousTime(unspecified))
        {
            var firstOffset = SelectedTimeZone.GetAmbiguousTimeOffsets(unspecified).Max();
            return new DateTimeOffset(unspecified, firstOffset).UtcDateTime;
        }

        return TimeZoneInfo.ConvertTimeToUtc(unspecified, SelectedTimeZone);
    }

    private string GetOccurrenceZoneLabel(DateTime wallClockTime)
    {
        if (timeZoneMode == ScheduleTimeZone.Utc)
        {
            return "UTC";
        }

        var unspecified = DateTime.SpecifyKind(wallClockTime, DateTimeKind.Unspecified);
        if (SelectedTimeZone.IsAmbiguousTime(unspecified))
        {
            var offsets = SelectedTimeZone.GetAmbiguousTimeOffsets(unspecified)
                .OrderByDescending(offset => offset)
                .Select(FormatUtcOffset);
            return $"{SelectedTimeZone.Id} ({string.Join(" / ", offsets)})";
        }

        return $"{SelectedTimeZone.Id} ({FormatUtcOffset(SelectedTimeZone.GetUtcOffset(unspecified))})";
    }

    private static string FormatUtcOffset(TimeSpan offset)
    {
        var sign = offset < TimeSpan.Zero ? "-" : "+";
        var absolute = offset.Duration();
        return $"UTC{sign}{absolute.Hours:00}:{absolute.Minutes:00}";
    }

    private static string[] SplitFields(string expression) => expression
        .Trim()
        .Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);

    private static string BuildScheduleSummary(string[] fields)
    {
        var names = fields.Length switch
        {
            5 => FiveFieldNames,
            6 => SixFieldNames,
            _ => [],
        };
        if (names.Length == 0)
        {
            return string.Empty;
        }

        return $"{fields.Length}-field schedule — {string.Join("; ", names.Zip(fields, (name, value) => $"{name} = {value}"))}.";
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            var key = Uri.UnescapeDataString(parts[0].Replace('+', ' '));
            var value = parts.Length == 2 ? Uri.UnescapeDataString(parts[1].Replace('+', ' ')) : string.Empty;
            values[key] = value;
        }

        return values;
    }

    public ValueTask DisposeAsync()
    {
        validationCancellation?.Cancel();
        validationCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }

    private enum ScheduleTimeZone
    {
        BrowserLocal,
        Utc,
    }
}
