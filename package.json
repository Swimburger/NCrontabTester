{
  "name": "ncrontab-tester",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "./build.sh",
    "build:cloudflare": "pnpm run build && cf build",
    "build:cloudflare:prebuilt": "cf build",
    "deploy": "pnpm run build:cloudflare && cf deploy --prebuilt",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "cf": "1.0.0-beta.32",
    "wrangler": "4.166.0"
  }
}
